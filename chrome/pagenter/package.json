{
	"name": "pagenter",
	"private": true,
	"version": "1.8.0",
	"type": "module",
	"description": "Pagenter restored source: AI-powered browser automation extension",
	"license": "MIT",
	"scripts": {
		"dev": "wxt",
		"build": "wxt build",
		"zip": "wxt zip",
		"postinstall": "wxt prepare",
		"typecheck": "wxt prepare && tsc --noEmit",
		"test": "vitest run",
		"check:any": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check-todo-types.ts",
		"compare": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/compare/cli.ts",
		"unchanged-files": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/unchanged-files.ts",
		"verify": "pnpm build && pnpm typecheck && pnpm check:any && pnpm test && pnpm compare"
	},
	"dependencies": {
		"ai-motion": "0.4.8",
		"chalk": "5.6.2",
		"zod": "4.3.6"
	},
