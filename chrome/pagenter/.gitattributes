# Check out with LF on every platform so builds are byte-identical
# regardless of core.autocrlf (BOT-1: a clean install builds the same output).
* text=auto eol=lf
*.png binary
*.webp binary
# Copied byte-for-byte from the bundle, whose locale files use CRLF
public/_locales/** -text
# Prompts are inlined byte-for-byte by ?raw; the bundle has them with CRLF
src/core/prompts/*.md -text
src/agent/*.md -text
# CSS modules: the class-name hash is taken over the raw file; the bundle was built from CRLF files
src/page-controller/mask/*.css -text
