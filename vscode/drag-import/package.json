{
  "name": "drag-import",
  "displayName": "Drag Import",
  "description": "拖入文件自动生成 import 语句（支持 Vue/React/TS/JS，支持别名路径）",
  "author": "lierniu",
  "version": "1.0.0",
  "publisher": "lierniu",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Drag Import",
      "properties": {
        "dragImport.aliases": {
          "type": "object",
          "default": {
            "@": "src"
          },
          "description": "路径别名映射，类似 Vite 的 resolve.alias。键是别名前缀，值是相对于项目根目录的路径。匹配到别名时使用别名路径，否则使用相对路径。\n示例: { \"@\": \"src\", \"@components\": \"src/components\", \"~\": \"./\" }"
        }
      }
    },
    "commands": [
      {
        "command": "dragImport.convertToImport",
        "title": "Convert to Import"
      }
    ],
    "keybindings": [
      {
        "command": "dragImport.convertToImport",
        "key": "cmd+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      },
      {
        "command": "dragImport.convertToImport",
        "key": "ctrl+alt+i",
        "linux": "ctrl+alt+i",
        "win": "ctrl+alt+i",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "import",
    "drag",
    "drop",
    "vue",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SZGG2333/cursor-extension.git"
  },
  "bugs": {
    "url": "https://github.com/SZGG2333/cursor-extension/issues"
  },
  "homepage": "https://github.com/SZGG2333/cursor-extension#readme",
  "icon": "images/icon.png"
}
